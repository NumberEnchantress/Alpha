{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alpha",
  "version": "0.1.0",
  "identifier": "org.example.alpha",
  "build": {
    "frontendDist": "web",
    "beforeBuildCommand": "node src-tauri/scripts/stage-web.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Alpha",
        "width": 1366,
        "height": 768,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
